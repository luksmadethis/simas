{
  "hosting": {
    "site": "ofisimas",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/v/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/v/**",
        "destination": "/simastok/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}